(footprint "MotorPad_SMD_2.6x3.6mm"
	(version 20240108)
	(generator "pcb-lab")
	(layer "F.Cu")
	(descr "Motor-wire solder pad (lap joint, 18-20 AWG), like an off-the-shelf ESC's phase pad. Three plated vias tie it to the inner/bottom layers for current and peel strength. Origin = pad centre. Vias on the -Y half (toward the FETs, where the current comes from); the wire lies on the +Y half and leaves over the board edge at +Y.")
	(tags "motor phase wire pad ESC")
	(attr smd)
	(fp_text reference "REF**" (at 0 2.8) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(fp_text value "MotorPad" (at 0 3.8) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.09))))
	(fp_rect (start -1.55 -2.05) (end 1.55 2.05) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_rect (start -1.3 -1.8) (end 1.3 1.8) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(pad "1" smd roundrect (at 0 0) (size 2.6 3.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
	(pad "1" thru_hole circle (at -0.75 -0.95) (size 0.7 0.7) (drill 0.35) (layers "*.Cu") (remove_unused_layers no))
	(pad "1" thru_hole circle (at 0.75 -0.95) (size 0.7 0.7) (drill 0.35) (layers "*.Cu") (remove_unused_layers no))
	(pad "1" thru_hole circle (at 0 -1.45) (size 0.7 0.7) (drill 0.35) (layers "*.Cu") (remove_unused_layers no))
